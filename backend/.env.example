# Copy to backend/.env; never commit real credentials.
PORT=8080
HOST=0.0.0.0
DATABASE_URL=postgresql://localhost:5432/firstaid
DB_USER=firstaid
DB_PASSWORD=
# DB_URL=jdbc:postgresql://localhost:5432/firstaid is also accepted for migration.

# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
SESSION_COOKIE_SECURE=false
# Use true behind HTTPS. Trust only the known number of reverse proxy hops.
TRUST_PROXY_HOPS=0
ADMIN_ORIGIN=http://127.0.0.1:5173
ADMIN_SEED_USERNAME=
ADMIN_SEED_PASSWORD=

PUBLIC_LOCALE=vi-VN
PUBLIC_REGION=VN-DN
EMERGENCY_NUMBER=115

AI_BASE_URL=http://127.0.0.1:8001
AI_INTERNAL_TOKEN=
AI_REQUEST_TIMEOUT_SECONDS=35
AI_IMAGE_TIMEOUT_SECONDS=35
AI_MAX_PER_MINUTE=20
# Optional comma-separated override of src/config/asset-keys.json:
# ASSET_ALLOWED_KEYS=
