{
  "name": "firstaid-backend",
  "version": "1.0.0",
  "private": true,
  "description": "FirstAid Node.js API, compatible with the existing mobile, admin and RAG services",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/database/migrate.js",
    "seed": "node scripts/database/seed.js",
    "smoke:api": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke/api.ps1",
    "smoke:ai": "node scripts/smoke/ai-gateway.js",
    "fixture:ai": "node tests/fixtures/mock-ai-server.js",
    "test": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "sharp": "^0.35.5"
  }
}
