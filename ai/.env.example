# Configure the same secret in Spring AI_INTERNAL_TOKEN. Never bundle in mobile.
AI_INTERNAL_TOKEN=
AI_INDEX_PATH=data/index/corpus.json
# Reject evidence older than this many days until it is rechecked/rebuilt.
AI_MAX_REVIEW_DAYS=180

# Server-only configuration. Extractive mode makes no cloud requests.
AI_GENERATION_MODE=extractive
AI_GENERATION_PROVIDER=gemini
AI_GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
# Optional legacy local provider: AI_GENERATION_PROVIDER=ollama
AI_OLLAMA_URL=http://127.0.0.1:11434
AI_OLLAMA_MODEL=
# Total budget for drafting plus verification. Keep below the gateway timeout.
AI_GENERATION_TIMEOUT_SECONDS=30
# Configure on the Spring server; mobile must wait longer than this.
AI_REQUEST_TIMEOUT_SECONDS=35
# Optional public snapshot in the trusted server network; checked every 30 seconds.
AI_PUBLIC_SNAPSHOT_URL=
